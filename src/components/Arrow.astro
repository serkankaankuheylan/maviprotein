---
interface Props { dir?: 'right' | 'down' | 'up' | 'out'; class?: string }
const { dir = 'right', class: cls = '' } = Astro.props;
const rot = { right: 0, down: 90, up: -90, out: -45 }[dir];
---
<svg class:list={['arr', cls]} viewBox="0 0 20 20" aria-hidden="true" style={rot ? `rotate:${rot}deg` : undefined}>
  <path d="M3 10h13M11.5 5.5 16 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
</svg>
