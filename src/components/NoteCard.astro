---
import Arrow from './Arrow.astro';
import Asset from './Asset.astro';
import NoteFigure from './NoteFigure.astro';
import { t, formatDate, type Lang } from '../lib/i18n';
import { href } from '../lib/routes';
import { NOTE_CATS, noteThumb, type Post } from '../lib/data';
interface Props {
  post: Post;
  lang: Lang;
  size?: 'l' | 's';
  /** 'image': the plate shows the first image on the note's page instead of its line figure (notes index). */
  media?: 'figure' | 'image';
  /** false: the plate gets no view-transition name, because another card on the page already carries it. */
  vt?: boolean;
}
const { post, lang, size = 's', media = 'figure', vt = true } = Astro.props;
const thumb = media === 'image' ? noteThumb(post) : undefined;
const vtName = `np-${post.id}`;
const sizes = '(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 30vw';
// A short parenthetical ("(2–4 Haziran 2016)") stays on one line, and a number range never breaks after its dash.
const title = String(t(post.title, lang))
  .replace(/\([^()]{1,24}\)/g, (m) => m.replace(/ /g, ' '))
  .replace(/(\d)([–-])(?=\d)/g, '$1$2⁠');
---
<article class:list={['note', `note--${size}`, `note--${post.category}`]}>
  <a href={href('note', lang, post.slug)}>
    <span class:list={['note__plate sheet', thumb && `note__plate--${thumb.kind}`]} style={vt ? `view-transition-name:${vtName}` : undefined} data-vt={vtName}>
      {thumb?.kind === 'asset' && <Asset name={thumb.name} alt="" class="note__img" sizes={sizes} />}
      {thumb?.kind === 'photo' && <img class="note__img" src={thumb.src} srcset={thumb.srcset} sizes={thumb.srcset && sizes} width={thumb.w} height={thumb.h} alt="" loading="lazy" decoding="async" />}
      {!thumb && <span class="note__no mono" aria-hidden="true">MP·{post.id}</span>}
      {!thumb && <NoteFigure post={post} />}
    </span>
    <span class="note__meta label">
      <time datetime={post.date}>{formatDate(post.date, lang)}</time>
      <span class="sep">·</span>
      <span>{t(NOTE_CATS[post.category] ?? NOTE_CATS.firma, lang)}</span>
    </span>
    <span class="note__title serif">{title}<span class="note__go" aria-hidden="true"><Arrow /></span></span>
    {size === 'l' && <span class="note__ex">{t(post.excerpt, lang)}</span>}
  </a>
</article>
<style>
  .note a { display: grid; gap: 1rem; align-content: start; height: 100%; }
  .note__plate { display: block; aspect-ratio: 16 / 10; transition: box-shadow 500ms var(--ease-water); }
  .note__plate :global(.nfig) { position: absolute; inset: 0; }
  .note__no { position: absolute; z-index: 1; top: 1.05rem; inset-inline-start: 1.6rem; font-size: 0.66rem; letter-spacing: 0.1em; color: var(--ink-3); }
  .note a:hover .note__plate, .note a:focus-visible .note__plate { box-shadow: inset 0 0 0 1px var(--rule-strong); }

  /* image plates (notes index): a photo fills the plate; a cutout sits on it like the note's own cover.
     Old-site files often carry a thin white frame (the Dubai invitation's sides, the İzmir one's foot):
     the photo is set 4% large so the plate trims it. */
  .note__plate :global(.note__img) { position: absolute; display: block; }
  .note__plate--photo :global(.note__img) { inset: 0; width: 100%; height: 100%; object-fit: cover; scale: 1.04; transition: scale 900ms var(--ease-water); }
  .note__plate--asset :global(.note__img) {
    inset: 11% 9%; width: 82%; height: 78%; object-fit: contain;
    filter: drop-shadow(0 16px 18px rgba(13, 27, 44, 0.14)) drop-shadow(0 3px 5px rgba(13, 27, 44, 0.1));
    transition: translate 700ms var(--ease-water);
  }
  .note a:hover .note__plate--photo :global(.note__img), .note a:focus-visible .note__plate--photo :global(.note__img) { scale: 1.075; }
  .note a:hover .note__plate--asset :global(.note__img), .note a:focus-visible .note__plate--asset :global(.note__img) { translate: 0 -5px; }
  @media (prefers-reduced-motion: reduce) { .note__plate :global(.note__img) { transition: none; } }

  .note__meta { color: var(--ink-3); margin-top: 0.3rem; }
  .note__title { font-size: clamp(1.25rem, 1.05rem + 0.55vw, 1.55rem); line-height: 1.2; letter-spacing: -0.012em; color: var(--ink); text-wrap: balance; }
  .note--l .note__title { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.4rem); }
  .note__ex { color: var(--ink-2); max-width: 54ch; text-wrap: pretty; }
  .note__go { display: inline-block; margin-inline-start: 0.4em; color: var(--brass); opacity: 0; translate: -6px 0; transition: opacity 400ms var(--ease-water), translate 400ms var(--ease-water); vertical-align: 0.05em; }
  .note__go :global(svg) { width: 0.8em; height: auto; }
  :global(html[dir='rtl']) .note__go { translate: 6px 0; scale: -1 1; }
  .note a:hover .note__go, .note a:focus-visible .note__go { opacity: 1; translate: 0 0; }
  @media (hover: none) { .note__go { opacity: 1; translate: 0 0; } }
</style>
