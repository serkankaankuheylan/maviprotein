---
/**
 * Competence groups as large numbered rows. Each row opens like a drawer
 * (native <details>: works without JS, keyboard friendly).
 */
import { t, type Lang } from '../lib/i18n';
interface Group { key: string; title: any; items: { title: any; detail?: any }[] }
interface Props { lang: Lang; groups: Group[]; open?: number; tone?: 'light' | 'dark' }
const { lang, groups, open = 0, tone = 'light' } = Astro.props;
---
<div class:list={['comp', `comp--${tone}`]}>
  {groups.map((g, i) => (
    <details class="comp__row" open={i === open} name="comp">
      <summary>
        <span class="comp__n mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="comp__t">{t(g.title, lang)}</span>
        <span class="comp__c mono">{g.items.length}</span>
        <span class="comp__x" aria-hidden="true"></span>
      </summary>
      <ul class="comp__items" role="list">
        {g.items.map((it) => (
          <li><span>{t(it.title, lang)}</span>{it.detail && <span class="faint t-small">{t(it.detail, lang)}</span>}</li>
        ))}
      </ul>
    </details>
  ))}
</div>
<style>
  .comp { border-top: 1px solid var(--line-strong); }
  .comp__row { border-bottom: 1px solid var(--line); }
  .comp__row summary { list-style: none; display: grid; grid-template-columns: 3.4rem 1fr auto 2rem; gap: 1rem; align-items: baseline; padding-block: 1.5rem; cursor: pointer; }
  .comp__row summary::-webkit-details-marker { display: none; }
  .comp__n { font-size: 0.8rem; color: var(--brass); }
  .comp--dark .comp__n { color: var(--brass-2); }
  .comp__t { font-family: var(--f-serif); font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.6rem); line-height: 1.08; letter-spacing: -0.02em; font-weight: 340; transition: transform 600ms var(--ease-water), color 300ms; }
  .comp__row summary:hover .comp__t { transform: translateX(8px); }
  :global(html[dir='rtl']) .comp__row summary:hover .comp__t { transform: translateX(-8px); }
  .comp__c { font-size: 0.75rem; color: var(--fg-3); }
  .comp__x { width: 1.2rem; height: 1.2rem; position: relative; align-self: center; }
  .comp__x::before, .comp__x::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform 500ms var(--ease-steel); }
  .comp__x::after { transform: rotate(90deg); }
  .comp__row[open] .comp__x::after { transform: rotate(0deg); }
  .comp__row[open] .comp__t { font-style: italic; }
  .comp__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--col-gap); padding: 0 0 2rem 4.4rem; }
  .comp__items li { display: grid; gap: 0.2rem; padding-block: 0.75rem; border-top: 1px solid var(--line); color: var(--fg-2); }
  .comp__row[open] .comp__items { animation: comp-drawer 700ms var(--ease-water) both; }
  @keyframes comp-drawer { from { opacity: 0; transform: translateY(-10px); } }
  @media (max-width: 760px) {
    .comp__row summary { grid-template-columns: 2.2rem 1fr 1.4rem; }
    .comp__c { display: none; }
    .comp__items { grid-template-columns: 1fr; padding-inline-start: 3.2rem; }
  }
</style>
