---
/**
 * Signature section: an extrusion line, station by station. The frame pins and vertical
 * scroll turns into free travel along the line (no steps, it follows the finger/wheel);
 * on desktop the material token in the middle of the frame transforms (powder → mash →
 * pellet → coated). Phones and tablets get the same ride with narrower stations; landscape
 * phones (too short to pin) and reduced motion get a vertical, fully legible version.
 */
import Asset from './Asset.astro';
import Arrow from './Arrow.astro';
/**
 * Optional, for the production-line pages (the home page passes none of these):
 *  - `n`: the station's number on the catalogue schema; `null` marks a station that completes the line end to
 *    end (grinding, packaging…) and gets a plain marker instead of a number. Without `n` stations count 1, 2, 3…
 *  - `metric`/`unit` may be empty; `href` links the station to its machine page (`linkLabel`).
 *  - `note` sits under the title; `products` lists what the line makes on the end card.
 */
interface Station { asset: string; name: string; machine: string; text: string; metric?: string; unit?: string; mat: string; matName: string; n?: number | null; href?: string }
interface Props {
  label: string; title: string; stations: Station[]; end: string; endLink: string; endHref: string; index?: string;
  id?: string; note?: string; products?: string[]; linkLabel?: string; auxLabel?: string;
  /** a smaller title and machine band, for longer titles with a note (line pages) */
  compact?: boolean;
}
const { label, title, stations, end, endLink, endHref, index = '03', id, note, products, linkLabel, auxLabel, compact = false } = Astro.props;
const mats = [...new Map(stations.map((s) => [s.mat, s])).values()];
---
<section class:list={['jr s-dark', { 'jr--compact': compact }]} data-surface="dark" data-journey id={id} style={`--n:${stations.length}`} aria-labelledby="jr-title">
  <svg class="jr__seam" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0v56c120 22 240 38 360 30s240-40 360-40 240 34 360 42 240-6 360-20V0Z" />
  </svg>
  <div class="jr__pin">
    <div class="jr__grid blueprint" aria-hidden="true"></div>
    <header class="jr__head wrap">
      <p class="label"><span>{index}</span><span class="sep">·</span><span>{label}</span></p>
      <h2 id="jr-title" class="t-h2" set:html={title} />
      {note && <p class="jr__note label faint">{note}</p>}
    </header>

    <div class="jr__now" aria-hidden="true">
      <div class="jr__now-stage">
        {mats.map((s) => (
          <Asset name={s.mat} alt="" sizes="(max-width: 1400px) 220px, 260px" class="jr__mat-img" data-mat={s.mat} />
        ))}
      </div>
      <p class="jr__now-name serif" data-jr-mat>{stations[0].matName}</p>
    </div>

    <ol class="jr__track" role="list" data-jr-track>
      {stations.map((s, i) => {
        const n = s.n === undefined ? i + 1 : s.n;
        return (
          <li class="jr__st" data-jr-st data-mat={s.mat} data-matname={s.matName} style={`--i:${i}`}>
            <figure class="jr__fig">
              <Asset name={s.asset} alt={s.machine} sizes="(max-width: 900px) 86vw, 34vw" class="jr__img" />
            </figure>
            <div class="jr__cap">
              {n === null ? <span class="num num--aux" title={auxLabel}><span class="sr-only">{auxLabel}</span></span> : <span class="num">{n}</span>}
              <div>
                <h3 class="jr__name serif">{s.name}</h3>
                <p class="jr__machine label">{s.machine}</p>
                <p class="jr__text">{s.text}</p>
                {s.metric && <p class="jr__metric"><span class="serif">{s.metric}</span> <span class="mono faint">{s.unit}</span></p>}
                {s.href && <a class="jr__link label" href={s.href}>{linkLabel}<Arrow /></a>}
              </div>
            </div>
          </li>
        );
      })}
      <li class="jr__end">
        <p class="t-h3">{end}</p>
        {products && products.length > 0 && <ul class="jr__products" role="list">{products.map((p) => <li>{p}</li>)}</ul>}
        <a class="btn btn--light" href={endHref}>{endLink}<Arrow /></a>
      </li>
    </ol>
    <div class="jr__rail" aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .jr { position: relative; background: var(--abyss); --seam: clamp(40px, 8vw, 120px); }
  /* waterline: the light section above sinks into the abyss instead of a hard cut */
  .jr__seam { position: absolute; inset-inline: 0; top: -1px; width: 100%; height: var(--seam); fill: var(--foam); z-index: 3; pointer-events: none; }
  .jr__grid { position: absolute; inset: 0; opacity: 0.55; mask-image: radial-gradient(120% 80% at 50% 55%, #000 30%, transparent 85%); -webkit-mask-image: radial-gradient(120% 80% at 50% 55%, #000 30%, transparent 85%); }
  .jr__head { position: relative; display: grid; gap: 0.9rem; padding-top: calc(var(--header-h) + 3vh); }
  .jr__head h2 { max-width: 18ch; }

  /* ---------- pinned horizontal (desktop, and phones/tablets tall enough to pin) ---------- */
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference), (min-height: 521px) and (prefers-reduced-motion: no-preference) {
    .jr { height: calc(var(--n) * 62vh + 120vh + var(--seam)); padding-top: var(--seam); }
    .jr__pin { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; grid-template-rows: auto 1fr; grid-template-columns: minmax(0, 1fr); }
    .jr__track { justify-self: start; }
    .jr__track {
      display: flex; align-items: center; gap: 0;
      padding-inline: calc(50vw - 21vw) 10vw;
      width: max-content; will-change: transform;
      transform: translate3d(calc(var(--x, 0) * -1px), 0, 0);
    }
    :global(html[dir='rtl']) .jr__track { transform: translate3d(calc(var(--x, 0) * 1px), 0, 0); }
    .jr__st { width: 42vw; padding-inline: 2.5vw; display: grid; gap: 2.2rem; align-content: center; opacity: 0.32; transform: scale(0.88); transition: opacity 700ms var(--ease-water), transform 900ms var(--ease-water); }
    .jr__st.is-focus { opacity: 1; transform: none; }
    .jr__fig { height: 36vh; display: grid; place-items: end center; position: relative; }
    .jr__img { max-height: 36vh; width: auto; object-fit: contain; filter: drop-shadow(0 30px 30px rgba(0, 0, 0, 0.45)) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3)); }
    .jr__end { width: 46vw; padding-inline: 4vw; display: grid; gap: 1.6rem; align-content: center; justify-items: start; }
    .jr__end p { max-width: 22ch; }
    .jr__rail { position: absolute; inset-inline: var(--gutter); bottom: 4.5vh; height: 1px; background: var(--line); }
    .jr__rail span { position: absolute; inset-block: 0; inset-inline-start: 0; width: 100%; background: var(--brass-2); transform-origin: left; transform: scaleX(var(--p, 0)); }
    :global(html[dir='rtl']) .jr__rail span { transform-origin: right; }

    /* the flow line all machines sit on */
    .jr__fig::after { content: ''; position: absolute; inset-inline: -2.5vw; bottom: -1px; border-top: 1px dashed var(--line-strong); }
    .jr__st .jr__cap { flex-direction: column; align-items: center; text-align: center; margin-inline: auto; }
    .jr__st .jr__cap .num { margin-top: 0; }
    .jr__st .jr__metric { justify-content: center; }
    /* "now on the line": the material leaving the focused station, centred above the line */
    .jr__now { position: absolute; left: 50%; top: calc(var(--header-h) + 3vh); transform: translateX(-50%); z-index: 2; display: grid; justify-items: center; gap: 0.7rem; }
  }

  .jr__track { position: relative; }
  .jr__cap { display: flex; gap: 1rem; align-items: flex-start; max-width: 36ch; }
  .jr__cap .num { margin-top: 0.3rem; }
  .jr__st.is-focus .num { background: var(--brass-2); color: var(--abyss); border-color: var(--brass-2); }
  .jr__name { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 360; }
  .jr__machine { margin-top: 0.45rem; color: var(--aegean); }
  .jr__text { margin-top: 0.8rem; color: var(--fg-2); font-size: 0.98rem; }
  .jr__metric { margin-top: 0.9rem; display: flex; align-items: baseline; gap: 0.5rem; }
  .jr__metric .serif { font-size: 1.5rem; color: var(--fg); }
  .jr__metric .mono { font-size: 0.75rem; letter-spacing: 0.06em; }
  /* line pages: a station that completes the line (not on the catalogue schema) carries a dashed marker */
  .num--aux { border-style: dashed; }
  .num--aux::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .jr__link { margin-top: 0.85rem; gap: 0.45em; color: var(--aegean); transition: color 300ms; }
  .jr__link :global(.arr) { width: 0.85rem; transition: transform 420ms var(--ease-water); }
  .jr__link:hover { color: var(--fg); }
  .jr__link:hover :global(.arr) { transform: translateX(3px); }
  :global(html[dir='rtl']) .jr__link :global(.arr) { transform: scaleX(-1); }
  .jr__note { max-width: 62ch; text-wrap: pretty; }
  .jr--compact .jr__head { gap: 0.7rem; }
  .jr--compact .jr__head h2 { font-size: clamp(1.7rem, 1.1rem + 1.55vw, 2.7rem); max-width: 19ch; }
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
    .jr--compact .jr__fig { height: 32vh; }
    .jr--compact .jr__img { max-height: 32vh; }
    .jr--compact .jr__st { gap: 1.8rem; }
  }
  /* phones: the pin starts below the waterline, so the title never slides under the foam seam */
  @media (max-width: 900px) and (min-height: 521px) and (prefers-reduced-motion: no-preference) {
    .jr.jr--compact { height: calc(var(--n) * 78vw + 100svh + var(--seam)); padding-top: var(--seam); }
  }
  .jr__products { display: flex; flex-wrap: wrap; gap: 0.45rem; max-width: 36rem; }
  .jr__products li { font-size: 0.86rem; padding: 0.38rem 0.75rem; border: 1px solid var(--line-strong); border-radius: 99px; color: var(--fg-2); }


  .jr__now-stage { position: relative; width: clamp(170px, 16vw, 260px); aspect-ratio: 1.55; }
  /* hairline the heap rests on: the same flow line the machines sit on */
  .jr__now-stage::after { content: ''; position: absolute; inset-inline: -6%; bottom: 0; border-top: 1px dashed var(--line-strong); }
  .jr__now-stage :global(.jr__mat-img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%;
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.5)) drop-shadow(0 3px 5px rgba(0, 0, 0, 0.35));
    opacity: 0; transform: translateY(-18px) scale(0.94);
    transition: opacity 700ms var(--ease-water), transform 900ms var(--ease-water);
  }
  .jr__now-stage :global(.jr__mat-img.is-on) { opacity: 1; transform: none; }
  .jr__now-name { text-align: center; white-space: nowrap; font-size: clamp(1.5rem, 1.1rem + 1vw, 2.2rem); line-height: 1; letter-spacing: -0.02em; font-weight: 360; color: var(--brass-2); }
  @media (max-height: 820px) {
    .jr__now { gap: 0.4rem; }
    .jr__now-stage { width: 140px; }
    .jr__now-name { font-size: 1.4rem; }
  }

  /* phones/tablets: narrower stations so the neighbours peek in at the edges. The pinned height is the
     line's own length (n stations × 78vw), so the line moves exactly as far as the finger does: a
     native-feeling sideways scroll, no faster and no slower than the rest of the page. */
  @media (max-width: 900px) and (min-height: 521px) and (prefers-reduced-motion: no-preference) {
    .jr { height: calc(var(--n) * 78vw + 100svh); padding-top: 0; }
    /* head · material · stations · room for the rail. The pin follows the *dynamic* viewport: when the
       browser bars collapse on the way down it gets taller (and eases there, the height transitions), and
       the extra height is shared by the material and the machine; on the way up they settle back. */
    .jr__pin {
      height: 100svh; height: 100dvh; transition: height 480ms var(--ease-water);
      padding-bottom: calc(var(--pb, 0px) + 1svh + 14px);
      grid-template-rows: auto minmax(7rem, 2fr) minmax(min-content, 5fr);
    }
    .jr__head { padding-top: calc(var(--header-h) + 2svh); transition: padding-top 520ms var(--ease-water); }
    /* the site header slides away while descending: its band goes to the line as well */
    :global(html:has(.hdr.is-hidden:not(.is-open))) .jr__head { padding-top: 2.5svh; }
    /* the material on the line, under the title, with its name under the hairline. It fills its share
       of the free height (a size container, so the heap scales with it). */
    .jr__now {
      position: relative; left: auto; top: auto; transform: none; z-index: 2;
      container-type: size; height: 100%; min-height: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
      padding-block: 0.4rem 0.2rem;
    }
    /* as large as its row allows (heaps are ~1.55:1), up to most of the screen width */
    .jr__now-stage { flex: none; width: clamp(110px, calc((100cqh - 2.4rem) * 1.5), min(62vw, 260px)); }
    .jr__now-name { font-size: clamp(1.1rem, 0.9rem + 1.2vw, 1.4rem); line-height: 1.1; }
    /* stations stretch to their row: the machine takes whatever the caption leaves */
    .jr__track { padding-inline: 11vw; align-items: stretch; }
    .jr__st { --st-gap: 1.3rem; width: 78vw; padding-inline: 3vw; gap: var(--st-gap); grid-template-rows: minmax(0, 1fr) auto; align-content: stretch; }
    .jr__fig { height: auto; min-height: 130px; container-type: size; }
    .jr__img { max-height: min(100cqh, 300px); max-width: 100cqw; }
    /* the station number sits on the flow line like a marker, instead of taking a row of its own */
    .jr__st .jr__cap { position: relative; padding-top: 1.15rem; }
    .jr__st .jr__cap .num { position: absolute; left: 50%; top: calc(-1 * var(--st-gap)); transform: translate(-50%, -50%); }
    /* opaque so the dashed line stops at the marker; the focused one keeps its brass fill */
    .jr__st:not(.is-focus) .jr__cap .num { background: var(--abyss); }
    .jr__fig::after { inset-inline: -3vw; }
    .jr__text { font-size: 0.92rem; }
    .jr__end { width: 78vw; padding-inline: 6vw; }
    .jr__rail { bottom: calc(var(--pb, 0px) + 1svh); }
  }
  /* the phone tab bar (MobileBar) covers the bottom: keep the line and the rail above it */
  @media (max-width: 760px) and (min-height: 521px) and (prefers-reduced-motion: no-preference) {
    .jr { --pb: calc(70px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 900px) and (min-height: 521px) and (max-height: 740px) and (prefers-reduced-motion: no-preference) {
    .jr__head { padding-top: calc(var(--header-h) + 0.6rem); }
    .jr__fig { min-height: 112px; }
    .jr__now { gap: 0.25rem; }
    .jr__now-name { font-size: 1rem; }
    .jr__st { --st-gap: 0.9rem; }
    .jr__name { font-size: 1.5rem; }
    .jr__machine { margin-top: 0.3rem; }
    .jr__text { font-size: 0.86rem; line-height: 1.45; }
    .jr__metric { margin-top: 0.5rem; }
    .jr__metric .serif { font-size: 1.3rem; }
    .jr__text { margin-top: 0.5rem; }
  }

  /* ---------- vertical (landscape phones / reduced motion) ---------- */
  @media (max-width: 900px) and (max-height: 520px), (prefers-reduced-motion: reduce) {
    .jr { padding-bottom: var(--sec-y); }
    .jr__pin { position: relative; }
    .jr__head { padding-top: var(--sec-y); margin-bottom: 3rem; }
    .jr__rail, .jr__now { display: none; }
    .jr__track { display: grid; gap: 3.2rem; padding-inline: var(--gutter); margin-inline: auto; max-width: 720px; }
    .jr__track::before { content: ''; position: absolute; inset-inline-start: calc(var(--gutter) + 0.92rem); top: 0; bottom: 0; border-inline-start: 1px dashed var(--line-strong); }
    .jr__st { display: grid; gap: 1rem; position: relative; }
    .jr__fig { padding-inline-start: 3rem; }
    .jr__img { filter: drop-shadow(0 20px 22px rgba(0, 0, 0, 0.45)); }
    .jr__cap .num { background: var(--abyss); position: relative; }
    .jr__end { display: grid; gap: 1.4rem; padding-inline-start: 3rem; justify-items: start; }
  }
</style>

<script>
  import { createDetent } from '../scripts/detent';
  // The page scrolls freely and natively; vertical scroll is mapped onto the line. A soft detent
  // (detent.ts) smooths wheel steps and, once the page is still, lets only the line glide the nearest
  // station to the centre — the page itself never moves and no input is intercepted.
  const sec = document.querySelector<HTMLElement>('[data-journey]');
  if (sec) {
    const pin = sec.querySelector<HTMLElement>('.jr__pin')!;
    const track = sec.querySelector<HTMLElement>('[data-jr-track]')!;
    const sts = [...sec.querySelectorAll<HTMLElement>('[data-jr-st]')];
    const end = sec.querySelector<HTMLElement>('.jr__end');
    const matName = sec.querySelector<HTMLElement>('[data-jr-mat]')!;
    const matImgs = [...sec.querySelectorAll<HTMLElement>('.jr__mat-img')];
    // same condition as the pinned CSS: desktop, or any screen tall enough to pin
    const mq = matchMedia('(min-width: 901px) and (prefers-reduced-motion: no-preference), (min-height: 521px) and (prefers-reduced-motion: no-preference)');
    let current = -1;
    const focus = (i: number) => {
      if (i === current) return;
      current = i;
      sts.forEach((s, k) => s.classList.toggle('is-focus', k === i));
      const st = sts[i];
      const nm = st.dataset.matname ?? '';
      if (matName.textContent !== nm) {
        matName.textContent = nm;
        matName.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 520, easing: 'cubic-bezier(.2,.7,.2,1)' });
      }
      matImgs.forEach((m) => m.classList.toggle('is-on', m.dataset.mat === st.dataset.mat));
    };

    // geometry measured on resize: the line's travel and each stop's x. The pinned range is read live
    // (the pin can follow the dynamic viewport and ease to a new height while the page moves).
    let padTop = 0, max = 0, centres: number[] = [], stops: number[] = [], pitch = 1;
    const measure = () => {
      padTop = parseFloat(getComputedStyle(sec).paddingTop) || 0;
      max = Math.max(0, track.scrollWidth - innerWidth);
      const mid = (el: HTMLElement) => Math.min(max, Math.max(0, el.offsetLeft + el.offsetWidth / 2 - innerWidth / 2));
      centres = sts.map(mid);
      stops = end ? [...centres, mid(end)] : centres;
      pitch = centres.length > 1 ? Math.max(1, centres[1] - centres[0]) : innerWidth;
    };
    /** scroll → x along the line (px); one rect read per frame */
    const read = () => {
      if (!mq.matches) return 0;
      const r = sec.getBoundingClientRect();
      const span = Math.max(1, r.height - padTop - pin.offsetHeight);
      return Math.min(1, Math.max(0, (-r.top - padTop) / span)) * max;
    };
    /** the stop to rest on: the nearest station (or the end card), a little biased the way the reader went */
    const nearest = (x: number, dir: number) => {
      const aim = x + dir * pitch * 0.12;
      let best = stops[0] ?? 0;
      for (const s of stops) if (Math.abs(s - aim) < Math.abs(best - aim)) best = s;
      return best;
    };
    let drawn = NaN;
    const apply = (x: number) => {
      if (!mq.matches || x === drawn) return;
      drawn = x;
      track.style.setProperty('--x', x.toFixed(1));
      sec.style.setProperty('--p', max ? (x / max).toFixed(4) : '0');
      // focus = the station whose centre is nearest the viewport centre
      let best = 0;
      centres.forEach((c, k) => { if (Math.abs(c - x) < Math.abs(centres[best] - x)) best = k; });
      focus(best);
    };
    measure();
    const detent = createDetent({ read, nearest, apply, jump: innerWidth * 1.5, eps: 0.2 });

    // the stations sit off-screen sideways, where lazy loading would start them late: load them all
    // once the section is a screen away, so a fast ride never shows a machine popping in
    const near = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      near.disconnect();
      sec.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
    }, { rootMargin: '100% 0px' });
    near.observe(sec);

    // a size change re-measures and lets the scene glide to the new mapping (no reset: a reset would
    // drop a settle in progress and jump); switching layouts starts clean
    const vertical = () => { track.style.removeProperty('--x'); sts.forEach((s) => s.classList.add('is-focus')); current = -1; };
    const ro = new ResizeObserver(() => { measure(); drawn = NaN; if (mq.matches) detent.kick(); else vertical(); });
    ro.observe(track);
    ro.observe(sec);
    const mode = () => { measure(); drawn = NaN; if (mq.matches) detent.reset(); else vertical(); };
    mq.addEventListener('change', mode);
    mode();
  }
</script>
