---
import { common, CONTACT } from '../i18n/common';
import { pick, type Lang } from '../lib/i18n';
import { href } from '../lib/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pick(common, lang);
---
<nav class="mbar" aria-label={c.footer.contact} data-mbar>
  <a href={CONTACT.phoneHref}>
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.2 2.8 8 6.6 6.6 8a9.6 9.6 0 0 0 5.4 5.4l1.4-1.4 3.8 1.8-.6 2.7c-.1.6-.7 1-1.3 1C8.5 17.3 2.7 11.5 2.5 4.7c0-.6.4-1.2 1-1.3Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
    {c.call}
  </a>
  <a href={CONTACT.whatsappHref} rel="noopener" target="_blank">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.3 16.7 4.4 13A7.2 7.2 0 1 1 7 15.6Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M7.6 7.2c.2 2.3 2.6 4.6 4.9 4.9l.8-1.1-1.4-.8-.6.6c-.9-.4-1.7-1.2-2.1-2.1l.6-.6-.8-1.4Z" fill="currentColor"/></svg>
    {c.whatsapp}
  </a>
  <a class="mbar__cta" href={href('start', lang)}>{c.cta}</a>
</nav>
<style>
  .mbar {
    position: fixed; z-index: 40; inset: auto 10px 10px 10px;
    display: none; grid-template-columns: 1fr 1fr 1.5fr; gap: 6px;
    padding: 6px; background: rgba(6, 26, 51, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--rule-light); border-radius: 4px;
    transform: translateY(140%); transition: transform 620ms var(--ease-water);
    padding-bottom: max(6px, env(safe-area-inset-bottom));
  }
  .mbar.is-on { transform: none; }
  .mbar a { min-height: 46px; display: flex; align-items: center; justify-content: center; gap: 0.45rem; color: var(--aegean-pale); font-size: 0.86rem; font-weight: 500; border-radius: 2px; }
  .mbar svg { width: 17px; height: 17px; }
  .mbar__cta { background: var(--foam); color: var(--abyss) !important; font-weight: 600 !important; }
  @media (max-width: 760px) { .mbar { display: grid; } }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  if (bar) {
    const onScroll = () => {
      const nearEnd = scrollY + innerHeight > document.documentElement.scrollHeight - 520;
      bar.classList.toggle('is-on', scrollY > 600 && !nearEnd);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
