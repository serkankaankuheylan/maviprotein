---
/**
 * A project dossier: application form, budget, work packages. Structure only —
 * skeleton rows instead of fake figures. Sheets fan out as the section scrolls in.
 */
interface Props { sheets: string[]; code?: string }
const { sheets, code = 'TÜBİTAK 1501 · HORIZON EUROPE · MSCA' } = Astro.props;
---
<div class="files" aria-hidden="true">
  <div class="sheet sheet--3">
    <span class="sheet__tab mono">{sheets[2]}</span>
    <div class="gantt">
      {['IP1', 'IP2', 'IP3', 'IP4', 'IP5'].map((w, i) => (
        <div class="gantt__row"><span class="mono">{w}</span><span class="gantt__bar" style={`--s:${[0, 14, 30, 46, 66][i]}%;--w:${[30, 38, 34, 28, 30][i]}%`}></span></div>
      ))}
      <div class="gantt__axis mono">{[1, 3, 6, 9, 12, 18].map((m) => <span>{m}</span>)}</div>
    </div>
  </div>
  <div class="sheet sheet--2">
    <span class="sheet__tab mono">{sheets[1]}</span>
    <div class="budget">
      {Array.from({ length: 7 }).map((_, i) => (
        <div class="budget__row"><i style={`--w:${[62, 44, 70, 38, 52, 46, 0][i]}%`}></i><b></b><b></b></div>
      ))}
    </div>
  </div>
  <div class="sheet sheet--1">
    <span class="sheet__tab mono">{sheets[0]}</span>
    <p class="sheet__code mono">{code}</p>
    <div class="form">
      <i style="--w:72%" class="h"></i>
      <i style="--w:94%"></i><i style="--w:88%"></i><i style="--w:91%"></i><i style="--w:54%"></i>
      <span class="form__field"></span>
      <i style="--w:90%"></i><i style="--w:84%"></i><i style="--w:40%"></i>
      <span class="form__sig"><svg viewBox="0 0 120 30"><path d="M4 22c10-14 16-16 18-8s-4 10 2 4 10-14 14-10-2 12 6 6 12-10 16-6 6 6 12 2 10-6 18-4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
    </div>
  </div>
</div>
<style>
  .files { position: relative; aspect-ratio: 5 / 5.6; max-width: min(var(--art-w, 560px), var(--art-h, 9999px) * 0.89); width: 100%; justify-self: center; }
  .sheet {
    position: absolute; inset: 6% 8% 4% 8%;
    background: #fbf9f4; border: 1px solid var(--rule); border-radius: 2px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03), 0 24px 40px -24px rgba(13, 27, 44, 0.35);
    padding: 3.2rem 1.6rem 1.6rem;
    transition: transform 1200ms var(--ease-water);
  }
  .sheet__tab { position: absolute; top: -1px; inset-inline-start: 1.2rem; transform: translateY(-100%); background: #fbf9f4; border: 1px solid var(--rule); border-bottom: 0; padding: 0.35rem 0.8rem; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); border-radius: 2px 2px 0 0; }
  .sheet--2 .sheet__tab { inset-inline-start: 38%; }
  .sheet--3 .sheet__tab { inset-inline-start: auto; inset-inline-end: 1.2rem; }
  .sheet--3 { transform: rotate(4deg) translate(6%, -3%); background: #f4f0e7; }
  .sheet--2 { transform: rotate(-2.5deg) translate(-3%, 1%); }
  .sheet--1 { transform: rotate(0.6deg); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sheet--3 { animation: fan3 linear both; animation-timeline: view(); animation-range: entry 10% cover 55%; }
      .sheet--2 { animation: fan2 linear both; animation-timeline: view(); animation-range: entry 10% cover 55%; }
    }
  }
  @keyframes fan3 { from { transform: rotate(0.6deg); } to { transform: rotate(6deg) translate(10%, -7%); } }
  @keyframes fan2 { from { transform: rotate(0.6deg); } to { transform: rotate(-4deg) translate(-7%, 3%); } }
  .sheet__code { font-size: 0.62rem; letter-spacing: 0.08em; color: var(--brass); margin-bottom: 1.2rem; }
  .form { display: grid; gap: 0.7rem; }
  .form i, .budget i { display: block; height: 6px; width: var(--w); background: var(--rule); border-radius: 3px; }
  .form i.h { height: 12px; background: var(--navy); opacity: 0.85; margin-bottom: 0.6rem; }
  .form__field { height: 54px; border: 1px dashed var(--rule-strong); margin-block: 0.4rem; }
  .form__sig { width: 120px; color: var(--navy); margin-top: 0.8rem; margin-inline-start: auto; }
  .budget { display: grid; gap: 0; border-top: 1px solid var(--rule-strong); }
  .budget__row { display: grid; grid-template-columns: 1fr 70px 70px; gap: 12px; align-items: center; padding-block: 0.85rem; border-bottom: 1px solid var(--rule); }
  .budget__row b { height: 6px; background: var(--sand-2); border-radius: 3px; }
  .budget__row:last-child b { background: var(--brass); }
  .gantt { display: grid; gap: 0.9rem; }
  .gantt__row { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.6rem; align-items: center; font-size: 0.62rem; color: var(--ink-3); }
  .gantt__bar { height: 12px; position: relative; background: repeating-linear-gradient(90deg, transparent 0 calc(100% / 6 - 1px), var(--rule) calc(100% / 6 - 1px) calc(100% / 6)); }
  .gantt__bar::after { content: ''; position: absolute; inset-block: 0; inset-inline-start: var(--s); width: var(--w); background: var(--phyco); opacity: 0.75; border-radius: 1px; }
  .gantt__axis { display: flex; justify-content: space-between; padding-inline-start: 3rem; font-size: 0.6rem; color: var(--ink-3); }
</style>
