---
/**
 * Arthrospira filaments: generative helices drawn as SVG (deterministic seed,
 * so the build is stable). Each filament drifts and slowly turns.
 */
interface Props { class?: string; count?: number; seed?: number }
const { class: cls = '', count = 14, seed = 7 } = Astro.props;
let s = seed;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const W = 1200, H = 800;
const fils = Array.from({ length: count }, () => {
  const len = 160 + rnd() * 260, turns = 5 + Math.floor(rnd() * 6), amp = 7 + rnd() * 9;
  const pts: string[] = [];
  const steps = turns * 16;
  for (let i = 0; i <= steps; i++) {
    const tt = i / steps;
    const x = tt * len;
    const y = Math.sin(tt * turns * Math.PI * 2) * amp * (0.85 + 0.15 * Math.sin(tt * 3));
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return {
    d: 'M' + pts.join(' L'),
    x: rnd() * W, y: rnd() * H, r: rnd() * 360, w: 1 + rnd() * 1.6,
    o: 0.25 + rnd() * 0.55, dur: 30 + rnd() * 40, delay: -rnd() * 40,
    c: rnd() > 0.45 ? '#7fd3f5' : '#7ee0c2',
  };
});
---
<svg class:list={['spirals', cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {fils.map((f) => (
    <g transform={`translate(${f.x.toFixed(0)} ${f.y.toFixed(0)}) rotate(${f.r.toFixed(0)})`}>
      <path class="fil" d={f.d} fill="none" stroke={f.c} stroke-width={f.w.toFixed(2)} stroke-linecap="round" opacity={f.o.toFixed(2)} style={`animation-duration:${f.dur.toFixed(0)}s;animation-delay:${f.delay.toFixed(0)}s`} />
    </g>
  ))}
</svg>
<style>
  .spirals { width: 100%; height: 100%; }
  .fil { transform-box: fill-box; transform-origin: center; animation: spiral-drift linear infinite alternate; }
  @keyframes spiral-drift { from { transform: translate(-20px, 10px) rotate(-8deg); } to { transform: translate(30px, -16px) rotate(10deg); } }
</style>
