---
/**
 * The site's sounding line. A thin ruler on the inline-start edge that descends as you read.
 * mode="depth": readout in metres (the page's metaphorical depth).
 * mode="reading": readout in percent (blog posts).
 * mode="years":  readout in years between `from` and `to` (about page).
 */
import { pick, type Lang } from '../lib/i18n';
import { common } from '../i18n/common';
interface Props { lang: Lang; mode?: 'depth' | 'reading' | 'years'; max?: number; from?: number; to?: number }
const { lang, mode = 'depth', max = 120, from = 1990, to = new Date().getFullYear() } = Astro.props;
const c = pick(common, lang);
const label = mode === 'reading' ? c.reading : mode === 'years' ? '' : c.depth;
const ticks = Array.from({ length: 41 }, (_, i) => i);
---
<div class="gauge" aria-hidden="true" data-gauge data-mode={mode} data-max={max} data-from={from} data-to={to}>
  <div class="gauge__ruler">
    {ticks.map((i) => <i class:list={{ major: i % 5 === 0 }} style={`--p:${i / 40}`}></i>)}
    <span class="gauge__mark" data-gauge-mark></span>
  </div>
  <div class="gauge__read mono">
    <span class="gauge__label">{label}</span>
    <span data-gauge-value>{mode === 'years' ? from : mode === 'reading' ? '0%' : '0 m'}</span>
  </div>
</div>
<style>
  .gauge {
    position: fixed; z-index: 30; inset-inline-start: 18px;
    top: calc(var(--header-h) + 28px); bottom: 28px; width: 34px;
    color: #fff; mix-blend-mode: difference; pointer-events: none;
    display: none;
  }
  @media (min-width: 1360px) { .gauge { display: block; } }
  .gauge__ruler { position: absolute; inset-block: 0 64px; inset-inline-start: 0; width: 12px; }
  .gauge__ruler i { position: absolute; inset-inline-start: 0; top: calc(var(--p) * 100%); width: 6px; height: 1px; background: currentColor; opacity: 0.38; }
  .gauge__ruler i.major { width: 12px; opacity: 0.7; }
  .gauge__mark { position: absolute; inset-inline-start: -4px; top: 0; width: 20px; height: 1px; background: currentColor; transform: translateY(calc(var(--g, 0) * (100vh - var(--header-h) - 120px))); }
  .gauge__mark::after { content: ''; position: absolute; inset-inline-end: -6px; top: -3px; border: 3.5px solid transparent; border-inline-start-color: currentColor; }
  .gauge__read { position: absolute; bottom: 0; inset-inline-start: 0; font-size: 0.64rem; letter-spacing: 0.08em; line-height: 1.3; display: grid; text-transform: uppercase; opacity: 0.9; }
  .gauge__label { opacity: 0.6; }
</style>
<script>
  const g = document.querySelector<HTMLElement>('[data-gauge]');
  if (g) {
    const v = g.querySelector<HTMLElement>('[data-gauge-value]')!;
    const mode = g.dataset.mode;
    const max = +g.dataset.max!, from = +g.dataset.from!, to = +g.dataset.to!;
    let raf = 0;
    const update = () => {
      raf = 0;
      const h = document.documentElement.scrollHeight - innerHeight;
      const p = h > 0 ? Math.min(1, Math.max(0, scrollY / h)) : 0;
      g.style.setProperty('--g', p.toFixed(4));
      if (mode === 'reading') v.textContent = Math.round(p * 100) + '%';
      else if (mode === 'years') v.textContent = String(Math.round(from + (to - from) * p));
      else v.textContent = '−' + String(Math.round(p * max)).padStart(3, '0') + ' m';
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
