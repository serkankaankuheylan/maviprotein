---
/**
 * Turnkey facility types as a drawing set: an index of the types beside one isometric plate per type
 * (src/lib/facilities, served as /cizim/<id>.svg). The plate is a plain <img>; its zones and flows are a
 * light inline overlay in the same viewBox, so a zone can be lit from the legend or the plate without
 * redrawing it. Without JS the sheets are a scroll-snap row and the index is anchor links.
 */
import Arrow from './Arrow.astro';
import { t, pick, type Lang } from '../lib/i18n';
import { facilityFor, plate } from '../lib/facilities';
import { facilityCopy } from '../i18n/facilities';

interface Props { lang: Lang; items: { title: any }[]; order?: string[] }
const { lang, items, order } = Astro.props;
const c = pick(facilityCopy, lang);
const r = (n: number) => Math.round(n * 10) / 10;
const pad = (n: number) => String(n).padStart(2, '0');

const set = items
  .map((it) => ({ it, def: facilityFor(t(it.title, 'tr')) }))
  .filter((x): x is { it: { title: any }; def: NonNullable<ReturnType<typeof facilityFor>> } => !!x.def);
if (order) set.sort((a, b) => order.indexOf(a.def.id) - order.indexOf(b.def.id));

const sheets = set.map(({ it, def }) => {
  const p = plate(def.id)!;
  const [vx, vy, vw, vh] = p.vb;
  const labels = c.zones[def.id] ?? {};
  const keys = Object.keys(labels);
  const zones = [...p.zones]
    .sort((a, b) => keys.indexOf(a.key) - keys.indexOf(b.key))
    .map((z) => ({ ...z, label: labels[z.key] ?? z.key, x: r(((z.mark[0] - vx) / vw) * 100), y: r(((z.mark[1] - vy) / vh) * 100) }));
  const frame = `M${r(vx)} ${r(vy)}h${r(vw)}v${r(vh)}h${r(-vw)}Z`;
  return { id: def.id, title: t(it.title, lang), p, zones, frame, vb: [vx, vy, vw, vh].map(r).join(' '), u: (vw / 1000).toFixed(3) };
});
const total = pad(sheets.length);
---
<div class="fs" data-fs>
  <nav class="fs__index" aria-label={c.index}>
    <ol role="list">
      {sheets.map((s, i) => (
        <li>
          <a href={`#tk-${s.id}`} data-fs-go={i} aria-current={i === 0 ? 'true' : undefined}>
            <span class="fs__no mono">{pad(i + 1)}</span>
            <span class="fs__name">{s.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="fs__view">
    <div class="fs__track" data-fs-track>
      {sheets.map((s, i) => (
        <figure class:list={['fs__sheet sheet', { 'is-on': i === 0 }]} id={`tk-${s.id}`} data-fs-sheet={i}>
          <div class="fs__fig" style={`aspect-ratio:${s.p.vb[2]}/${s.p.vb[3]}`}>
            <img src={`/cizim/${s.id}.svg`} alt={`${s.title}: ${c.plan}`} width="1600" height="1000" loading="lazy" decoding="async" />
            <svg class="fs__ov" viewBox={s.vb} style={`--u:${s.u}px`} aria-hidden="true">
              {s.zones.map((z) => <path class="fs__dim" data-z={z.key} fill-rule="evenodd" d={`${s.frame}${z.hull}`} />)}
              {s.p.flows.map((fl) => (
                <g class={`fs__flow fs__flow--${fl.kind}`}>
                  <path class="fs__fl" d={fl.d} pathLength="1" />
                  {fl.arrows && <path class="fs__ar" d={fl.arrows} />}
                </g>
              ))}
              {s.zones.map((z) => (
                <g class="fs__zone" data-z={z.key}>
                  <path class="fs__zs" d={z.sides} />
                  <path class="fs__zt" d={z.top} />
                </g>
              ))}
              {s.zones.map((z) => <path class="fs__lead" data-z={z.key} d={z.leader} />)}
            </svg>
            {s.zones.map((z, k) => (
              <span class="fs__mark num" data-z={z.key} style={`--x:${z.x}%;--y:${z.y}%`} aria-hidden="true">{k + 1}</span>
            ))}
          </div>
          <figcaption class="fs__cap">
            <div class="fs__head">
              <h3 class="t-h4">{s.title}</h3>
              <span class="fs__count mono">{pad(i + 1)} / {total}</span>
            </div>
            <ol class="fs__legend" role="list">
              {s.zones.map((z, k) => (
                <li><button type="button" data-z={z.key} aria-pressed="false"><span class="num">{k + 1}</span><span>{z.label}</span></button></li>
              ))}
            </ol>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="fs__nav">
      <button type="button" class="fs__btn fs__btn--prev" data-fs-step="-1" aria-label={c.prev} disabled><Arrow /></button>
      <button type="button" class="fs__btn" data-fs-step="1" aria-label={c.next}><Arrow /></button>
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-fs]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-fs-track]')!;
    const sheets = [...root.querySelectorAll<HTMLElement>('[data-fs-sheet]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-fs-go]')];
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-fs-step]')];
    let cur = 0;

    const setActive = (i: number) => {
      if (i === cur && sheets[i].classList.contains('is-on')) return;
      cur = i;
      sheets.forEach((s, k) => s.classList.toggle('is-on', k === i));
      links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      steps[0].disabled = i === 0;
      steps[1].disabled = i === sheets.length - 1;
      // the next plate starts loading before it is reached
      sheets[i + 1]?.querySelector('img')?.setAttribute('loading', 'eager');
    };
    const go = (i: number) => {
      const k = Math.max(0, Math.min(sheets.length - 1, i));
      // align the sheet's inline start with the track's (scrollBy is direction-agnostic)
      const a = sheets[k].getBoundingClientRect(), b = track.getBoundingClientRect();
      const rtl = getComputedStyle(track).direction === 'rtl';
      track.scrollBy({ left: rtl ? a.right - b.right : a.left - b.left, behavior: reduce ? 'auto' : 'smooth' });
      setActive(k);
    };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); go(i); }));
    steps.forEach((b) => b.addEventListener('click', () => go(cur + Number(b.dataset.fsStep))));

    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) setActive(Number((e.target as HTMLElement).dataset.fsSheet));
    }, { root: track, threshold: 0.6 });
    sheets.forEach((s) => io.observe(s));
    // the flows of the open sheet are drawn once the set comes into view
    const seen = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { root.classList.add('is-seen'); seen.disconnect(); }
    }, { threshold: 0.3 });
    seen.observe(track);

    // zones: legend buttons and plate markers light the same zone
    const light = (sheet: HTMLElement, key: string | null) => {
      sheet.classList.toggle('has-zone', !!key);
      sheet.querySelectorAll<HTMLElement | SVGElement>('[data-z]').forEach((el) => el.classList.toggle('is-on', el.dataset.z === key));
    };
    sheets.forEach((sheet) => {
      let pinned: string | null = null;
      sheet.querySelectorAll<HTMLElement>('button[data-z], .fs__mark').forEach((el) => {
        el.addEventListener('pointerenter', () => light(sheet, el.dataset.z!));
        el.addEventListener('pointerleave', () => light(sheet, pinned));
        el.addEventListener('focus', () => light(sheet, el.dataset.z!));
        el.addEventListener('blur', () => light(sheet, pinned));
      });
      sheet.querySelectorAll<HTMLButtonElement>('button[data-z]').forEach((b) => b.addEventListener('click', () => {
        pinned = pinned === b.dataset.z ? null : b.dataset.z!;
        sheet.querySelectorAll('button[data-z]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.z === pinned)));
        light(sheet, pinned);
      }));
    });
  });
</script>

<style>
  .fs { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--col-gap); align-items: start; }

  /* index: the drawing register */
  .fs__index { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 24px); }
  .fs__index ol { border-top: 1px solid var(--line-strong); }
  .fs__index a { position: relative; display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.6rem; align-items: baseline; padding: 0.82rem 0; border-bottom: 1px solid var(--line); color: var(--fg-2); transition: color 300ms; }
  .fs__index a::after { content: ''; position: absolute; inset-inline-start: 0; bottom: -1px; width: 100%; height: 1px; background: var(--brass); transform: scaleX(0); transform-origin: left; transition: transform 600ms var(--ease-steel); }
  :global(html[dir='rtl']) .fs__index a::after { transform-origin: right; }
  .fs__index a:hover, .fs__index a[aria-current] { color: var(--fg); }
  .fs__index a[aria-current]::after { transform: scaleX(1); }
  .fs__no { font-size: 0.8rem; color: var(--fg-3); transition: color 300ms; }
  .fs__index a[aria-current] .fs__no { color: var(--brass); }
  .fs__name { font-size: 1.02rem; line-height: 1.35; }

  /* sheets */
  .fs__view { grid-column: 5 / -1; min-width: 0; }
  .fs__track { display: flex; gap: var(--col-gap); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .fs__track::-webkit-scrollbar { display: none; }
  .fs__sheet { flex: 0 0 100%; scroll-snap-align: start; margin: 0; padding: clamp(14px, 2.2vw, 32px); display: grid; gap: clamp(16px, 2vw, 26px); }
  .fs__fig { position: relative; width: 100%; }
  .fs__fig img, .fs__ov { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fs__ov { pointer-events: none; overflow: visible; }

  /* overlay: dim outside the lit zone, the zone as a volume, leaders, flows */
  .fs__dim { fill: var(--plate); fill-opacity: 0; transition: fill-opacity 500ms var(--ease-water); }
  .fs__dim.is-on { fill-opacity: 0.66; }
  .fs__zone path { fill: var(--phyco); stroke: var(--phyco); stroke-width: calc(var(--u) * 1.1); stroke-linejoin: round; opacity: 0; transition: opacity 400ms var(--ease-water); }
  .fs__zs { fill-opacity: 0.1; }
  .fs__zt { fill-opacity: 0.05; }
  .fs__zone.is-on path { opacity: 1; }
  .fs__lead { fill: none; stroke: var(--brass); stroke-width: calc(var(--u) * 1); stroke-dasharray: calc(var(--u) * 2) calc(var(--u) * 3); opacity: 0.75; }
  .fs__lead.is-on { stroke-dasharray: none; opacity: 1; }
  .fs__flow path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  /* without JS every flow is simply drawn; with JS the open sheet's flow draws itself in */
  .fs__fl { stroke-width: calc(var(--u) * 1.5); stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1800ms var(--ease-steel) 200ms; }
  .fs__ar { stroke-width: calc(var(--u) * 1.5); transition: opacity 600ms 1200ms; }
  :global(.js) .fs:not(.is-seen) .fs__fl, :global(.js) .fs__sheet:not(.is-on) .fs__fl { stroke-dashoffset: 1; }
  :global(.js) .fs:not(.is-seen) .fs__ar, :global(.js) .fs__sheet:not(.is-on) .fs__ar { opacity: 0; }
  .fs__flow--water path { stroke: var(--phyco); }
  .fs__flow--product path { stroke: var(--brass); }
  .fs__flow--air path { stroke: var(--ink-2); }
  .fs__flow--air .fs__fl { stroke-dasharray: calc(var(--u) * 5) calc(var(--u) * 4); stroke-dashoffset: 0; opacity: 0.7; transition: opacity 800ms 200ms; }
  :global(.js) .fs:not(.is-seen) .fs__flow--air .fs__fl, :global(.js) .fs__sheet:not(.is-on) .fs__flow--air .fs__fl { stroke-dashoffset: 0; opacity: 0; }
  .fs__sheet.has-zone .fs__flow { opacity: 0.25; transition: opacity 400ms; }

  .fs__mark { --s: 1.45rem; position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); background: var(--plate); font-size: 0.7rem; z-index: 1; cursor: default; }
  .fs__mark.is-on { background: var(--brass); color: var(--foam); border-color: var(--brass); }

  /* caption: title block and zone legend */
  .fs__cap { display: grid; gap: 0.9rem; border-top: 1px solid var(--line-strong); padding-top: 1rem; }
  .fs__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .fs__count { font-size: 0.8rem; color: var(--fg-3); flex: none; }
  .fs__legend { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr)); gap: 0.15rem var(--col-gap); }
  .fs__legend button { display: flex; gap: 0.6rem; align-items: center; width: 100%; padding: 0.3rem 0; text-align: start; font-size: 0.92rem; line-height: 1.3; color: var(--fg-2); transition: color 250ms; }
  .fs__legend .num { --s: 1.45rem; font-size: 0.7rem; }
  .fs__legend button:hover, .fs__legend button.is-on, .fs__legend button[aria-pressed='true'] { color: var(--fg); }
  .fs__legend button.is-on .num { background: var(--brass); color: var(--foam); }

  .fs__nav { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem; }
  .fs__btn { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--fg); transition: background 300ms, color 300ms, opacity 300ms; }
  .fs__btn:hover:not(:disabled) { background: var(--navy); color: var(--foam); border-color: var(--navy); }
  .fs__btn:disabled { opacity: 0.3; cursor: default; }
  .fs__btn--prev :global(.arr) { transform: scaleX(-1); }
  :global(html[dir='rtl']) .fs__btn :global(.arr) { transform: scaleX(-1); }
  :global(html[dir='rtl']) .fs__btn--prev :global(.arr) { transform: none; }

  @media (max-width: 1000px) {
    .fs { grid-template-columns: minmax(0, 1fr); }
    .fs__index { display: none; }
    .fs__view { grid-column: 1; }
    .fs__sheet { flex-basis: 90%; }
    .fs__nav { justify-content: flex-start; }
    .fs__zone path { stroke-width: calc(var(--u) * 2.4); }
    .fs__fl, .fs__ar { stroke-width: calc(var(--u) * 3); }
    .fs__lead { stroke-width: calc(var(--u) * 2); }
    .fs__mark { --s: 1.2rem; font-size: 0.62rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .fs .fs__sheet .fs__fl { stroke-dashoffset: 0; }
    :global(.js) .fs .fs__sheet .fs__ar { opacity: 1; }
  }
</style>
