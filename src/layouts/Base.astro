---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DepthGauge from '../components/DepthGauge.astro';
import MobileBar from '../components/MobileBar.astro';
import { LANG_META, LANGS, type Lang } from '../lib/i18n';
import { alternates as alts, type RouteKey } from '../lib/routes';
import { CONTACT } from '../i18n/common';
// The two faces the first screen is recognised by — the page title and the logo name — are requested right
// after the stylesheets instead of after the first layout, so they don't appear in the fallback face and then
// jump. Same files the @font-face rules point at. Kept to two: on a slow line every extra preload delays the CSS.
import fontDisplay500 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-500-normal.woff2?url';
import fontDisplay700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import fontLogo from '../fonts/newsreader-logo.woff2?url';
import fontArabic400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  route: RouteKey;
  slug?: string;
  startDark?: boolean;
  gauge?: 'depth' | 'reading' | 'years' | false;
  gaugeMax?: number;
  ogImage?: string;
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
}
const { lang, title, description, route, slug, startDark = true, gauge = 'depth', gaugeMax = 120, ogImage = '/og/default.jpg', jsonLd = [], noindex = false } = Astro.props;
const meta = LANG_META[lang];
const alternates = alts(route, slug);
const site = Astro.site!.origin;
const canonical = site + alternates[lang];
const fullTitle = route === 'home' ? title : `${title} · Mavi Protein`;
// home hero: .t-mega (700); every other page opens on .t-display (500). Arabic titles and body both set in
// IBM Plex Sans Arabic 400: without it the first screen is laid out in a fallback face and reflows when it lands.
const preloadFonts = lang === 'ar' ? [fontArabic400, fontLogo] : [route === 'home' ? fontDisplay700 : fontDisplay500, fontLogo];
// Instant next pages: hovering a link (~200 ms) or pressing it prerenders the page in the background, so
// it opens fully painted, through the view transition. Downloads and PDFs are left alone.
const speculation = {
  prerender: [{
    where: { and: [
      { href_matches: '/*' },
      { not: { href_matches: '/docs/*' } },
      { not: { selector_matches: '[download], [target="_blank"], [rel~="nofollow"]' } },
    ] },
    eagerness: 'moderate',
  }],
};
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mavi Protein Danışmanlık',
  legalName: 'Mavi Protein Danışmanlık Su Ürünleri Tarım ve Hayvancılık Turizm San. ve Tic. Ltd. Şti.',
  url: site,
  logo: site + '/img/brand/mavilogo.png',
  foundingDate: '2015',
  founder: { '@type': 'Person', name: 'Fatih Başaran', honorificPrefix: 'Doç. Dr.' },
  email: CONTACT.email,
  telephone: CONTACT.phone,
  address: { '@type': 'PostalAddress', streetAddress: 'Halkapınar Mah. 1203 Sk. No:13/1309', addressLocality: 'Konak', addressRegion: 'İzmir', addressCountry: 'TR' },
  sameAs: CONTACT.social.map(([, u]) => u),
};
---
<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {LANGS.map((l) => <link rel="alternate" hreflang={LANG_META[l].htmlLang} href={site + alternates[l]} />)}
    <link rel="alternate" hreflang="x-default" href={site + alternates.tr} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mavi Protein Danışmanlık" />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#061a33" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <slot name="head" />
  </head>
  <body data-route={route}>
    {/* here rather than in <head>: Astro appends the stylesheets at the end of <head>, and these must not queue
        ahead of them (render-blocking CSS first, then the faces) */}
    {preloadFonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <Header lang={lang} alternates={alternates} current={route} startDark={startDark} />
    {gauge && <DepthGauge lang={lang} mode={gauge} max={gaugeMax} />}
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    <MobileBar lang={lang} />
    <script>
      // Reveal: elements rise out of / sink into view once. Two-tier — content is visible without JS.
      const els = document.querySelectorAll<HTMLElement>('.rise, .sink');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
