---
import Tally from '../components/Tally.astro';
import Base from '../layouts/Base.astro';
import Asset from '../components/Asset.astro';
import Arrow from '../components/Arrow.astro';
import Journey from '../components/Journey.astro';
import Chain from '../components/Chain.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import SpecimenSplash from '../components/SpecimenSplash.astro';
import { splashPieces } from '../lib/splash';
import NoteCard from '../components/NoteCard.astro';
import ClosingCta from '../components/ClosingCta.astro';
import FileStack from '../components/FileStack.astro';
import Microscope from '../components/Microscope.astro';
import StandardSeals from '../components/StandardSeals.astro';
import Paperclip from '../components/Paperclip.astro';
import { recordGalleries } from '../data/record-galleries';
import { home } from '../i18n/home';
import { pick, type Lang } from '../lib/i18n';
import { href, type RouteKey } from '../lib/routes';
import { lines, postsSorted } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pick(home, lang);
// Kicker "Place · claim" → place set as a serif name, claim as a sounding reading with the year in brass.
const [kPlace, kClaim = ''] = c.hero.kicker.split(' · ');
const kParts = kClaim.split(/(\d{4})/).map((t) => ({ t, yr: /^\d{4}$/.test(t) }));
const featuredIds = [64, 65, 67];
const notes = featuredIds.map((id) => postsSorted.find((p) => p.id === id)).filter(Boolean) as typeof postsSorted;
// Sector scenes: one soft, opaque AI background per world (≈10–25 KB each) + cut-outs placed in it.
const worldScenes: Record<string, string> = { aquaculture: 'w-sea-bg', lines: 'w-factory-bg', agri: 'w-field-bg' };
// Sea bream life cycle, rising from the deep (egg) toward the light (adult).
const lifeStages = [
  { asset: 'b-fish-eggs', sizes: '(max-width: 900px) 22vw, 12vw' },
  { asset: 'b-larva', sizes: '(max-width: 900px) 34vw, 20vw' },
  { asset: 'b-juvenile', sizes: '(max-width: 900px) 38vw, 22vw' },
  { asset: 'b-sea-bream', sizes: '(max-width: 900px) 60vw, 34vw' },
];
// Field records: what is clipped to each fiche. Only photos whose subject the source verifies
// (blog cover, printed packaging, invitation); Turkuaz Marin has no photo, so it gets an ink stamp.
type Print = { src: string; w: number; h: number; cap?: string };
const recordPins: Record<string, { layout: 'stamp' | 'single' | 'portrait' | 'pair' | 'fan'; prints?: Print[] }> = {
  'turkuaz-marin': { layout: 'stamp' },
  // Plant photo behind, the range (cat, parrot) fanned out, the real 2 kg bag in front. Source: blog 67 / archive.
  rotika: {
    layout: 'fan',
    prints: [
      { src: '/img/records/rotika-tesis-640.webp', w: 640, h: 480, cap: 'Rotika · 2020' },
      { src: '/img/records/rotika-yetiskin-kedi-640.webp', w: 356, h: 640 },
      { src: '/img/records/rotika-orta-buyuk-papagan-640.webp', w: 398, h: 640 },
      { src: '/img/records/rotika-ambalaj-640.webp', w: 355, h: 640, cap: '2 kg' },
    ],
  },
  sunpring: { layout: 'single', prints: [{ src: '/img/records/agra-me-2016-davetiye-sunpring-640.webp', w: 640, h: 418, cap: 'Dubai · 03.2016' }] },
  fuarlar: {
    layout: 'pair',
    prints: [
      { src: '/img/records/agra-me-2016-dubai-640.webp', w: 640, h: 360, cap: 'Dubai · 03.2016' },
      { src: '/img/records/future-fish-2016-izmir-640.webp', w: 640, h: 360, cap: 'İzmir · 06.2016' },
    ],
  },
};
---
<Base lang={lang} title={c.meta.title} description={c.meta.description} route="home" gaugeMax={180}>
  <!-- 01 · SURFACE -->
  <section class="hero s-dark" data-surface="dark" aria-labelledby="hero-title">
    <canvas class="hero__water" data-caustics aria-hidden="true"></canvas>
    <canvas class="hero__pellets" data-pellets aria-hidden="true"></canvas>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="hero__kicker">
        <span class="hero__place">{kPlace}</span>
        <span class="sr-only"> · </span>
        <span class="hero__sounding" aria-hidden="true"></span>
        <span class="label hero__claim">{kParts.map((p) => (p.yr ? <b class="hero__yr">{p.t}</b> : p.t))}</span>
      </p>
      <h1 id="hero-title" class="t-mega hero__title">
        {c.hero.title.map((w, i) => <span class="hero__w" style={`--i:${i}`}>{i === c.hero.title.length - 1 ? <em>{w}</em> : w}</span>)}
      </h1>
      <p class="t-lead hero__lead">{c.hero.lead}</p>
    </div>
    <nav class="hero__intents wrap" aria-label={c.hero.intentsLabel}>
      <p class="label faint">{c.hero.intentsLabel}</p>
      <ul role="list">
        {c.hero.intents.map((it, i) => (
          <li style={`--i:${i}`}>
            <a href={href(it.route as RouteKey, lang, undefined, it.hash)}>
              <span class="mono faint">{it.n}</span>
              <span class="hero__intent">{it.text}</span>
              <Arrow />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <svg class="hero__seam" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120V64c120-22 240-38 360-30s240 40 360 40 240-34 360-42 240 6 360 20v68Z" />
    </svg>
  </section>

  <!-- 02 · CHAIN (compass) -->
  <Chain lang={lang} index="01" {...c.chain} />

  <!-- 03 · THREE WORLDS -->
  <section class="worlds s-light section" data-surface="light" aria-labelledby="worlds-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="label"><span>02</span><span class="sep">·</span><span>{c.worlds.label}</span></p>
        <h2 id="worlds-title" class="t-h1 rise" set:html={c.worlds.title} />
        <p class="t-lead rise" style="--d:120ms">{c.worlds.lead}</p>
      </header>
    </div>
    <div class="worlds__row" data-worlds>
      <div class="worlds__stage" data-stage data-active="0">
        {c.worlds.panels.map((p, i) => (
          <a class:list={['world', `world--${p.key}`, { 'is-open': i === 0 }]} href={href(p.key as RouteKey, lang)} data-world style={`--i:${i}`}>
            <span class="world__scene" aria-hidden="true">
              <Asset name={worldScenes[p.key]} alt="" class="world__bg" sizes="(max-width: 900px) 100vw, 55vw" />
            </span>
            {p.key === 'aquaculture' && (
              <span class="world__art world__art--life" aria-hidden="true">
                <svg class="life__path" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M13 76 C 20 68, 25 61, 31 57 S 40 44, 45 39 S 58 22, 70 17" /></svg>
                {lifeStages.map((st, k) => (
                  <span class={`stage stage--${k}`} style={`--k:${k}`}>
                    <Asset name={st.asset} alt="" sizes={st.sizes} />
                    <span class="stage__label">{c.worlds.stages[k]}</span>
                  </span>
                ))}
              </span>
            )}
            {p.key === 'lines' && (
              <span class="world__art world__art--floor" aria-hidden="true">
                <span class="floor__shadow"></span>
                <Asset name="sp85-ii-extruder" alt="" class="floor__machine" sizes="(max-width: 900px) 80vw, 40vw" />
                <span class="floor__shadow floor__shadow--pile"></span>
                <Asset name="fish-feed-pellets" alt="" class="floor__pile" sizes="(max-width: 900px) 30vw, 12vw" />
              </span>
            )}
            <span class="world__veil" aria-hidden="true"></span>
            <span class="world__body">
              <span class="world__head">
                <span class="label">0{i + 1}</span>
                <span class="world__title serif">{p.title}</span>
              </span>
              <span class="world__detail">
                <span class="world__text">{p.text}</span>
                <span class="world__items">
                  {p.items.map((x) => <span>{x}</span>)}
                </span>
                <span class="world__more">{c.worlds.more}<Arrow /></span>
              </span>
            </span>
          </a>
        ))}
      </div>
      <svg class="worlds__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 56c120 22 240 38 360 30s240-40 360-40 240 34 360 42 240-6 360-20V120H0Z" />
      </svg>
    </div>
  </section>

  <!-- 04 · LINE JOURNEY (signature) -->
  <Journey {...c.journey} endHref={href('lines', lang)} index="03" />

  <!-- 05 · SPECIMENS -->
  <section class="specimens s-sand grain section" data-surface="light" aria-labelledby="spec-title">
    <div class="wrap">
      <header class="spec-head rise">
        <span class="spec-head__no label" aria-hidden="true">04</span>
        <hgroup class="spec-head__title">
          <h2 id="spec-title" class="t-h1">{c.specimens.title}</h2>
          <p class="t-h1 spec-head__sub" set:html={c.specimens.sub} />
        </hgroup>
      </header>
      <div class="spec-stage">
        <SpecimenSplash pieces={splashPieces} />
        <ol class="specimens__grid" role="list">
          {lines.map((line) => <li class="rise"><SpecimenCard line={line} lang={lang} /></li>)}
          {lines.length % 2 === 1 && <li class="specimens__fill" aria-hidden="true"></li>}
        </ol>
      </div>
    </div>
  </section>

  <!-- 06 · PROOF -->
  <section class="proof s-light grain section" data-surface="light" aria-labelledby="proof-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="label"><span>05</span></p>
        <h2 id="proof-title" class="t-h1 rise" set:html={c.proof.title} />
      </header>
      <div class="proof__grid">
        <figure class="exhibit rise">
          <img
            src="/img/photos/kurucu-future-fish-2016-1600.webp"
            srcset="/img/photos/kurucu-future-fish-2016-800.webp 800w, /img/photos/kurucu-future-fish-2016-1600.webp 1600w"
            sizes="(max-width: 900px) 92vw, 54vw"
            width="1600" height="899" loading="lazy" decoding="async"
            alt={c.proof.exhibit.alt}
          />
          <figcaption>
            <p class="proof__name serif">{c.proof.founder}</p>
            <p class="label">{c.proof.founderRole}</p>
          </figcaption>
        </figure>
        <div class="proof__words">
          <blockquote class="proof__quote serif rise">
            <p>“{c.proof.quote}”</p>
          </blockquote>
          <p class="proof__text rise">{c.proof.founderText}</p>
          <ol class="proof__line" role="list">
            {c.proof.timeline.map((e, i) => (
              <li class:list={['rise', { 'is-exhibit': e.y === c.proof.exhibit.year }]} style={`--d:${i * 80}ms`}>
                <span class="proof__y mono">{e.y}</span>
                <span class="proof__tick" aria-hidden="true"></span>
                <span>{e.t}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <dl class="proof__figs">
        {c.proof.figures.map((f, i) => (
          <div class="rise" style={`--d:${i * 90}ms`}>
            <dt class="figure"><Tally value={f.n} />{f.u && <small>{f.u}</small>}</dt>
            <dd class="label">{f.c}</dd>
          </div>
        ))}
      </dl>
      <StandardSeals lang={lang} {...c.proof.stamps} />
    </div>
  </section>

  <!-- 07 · FIELD RECORDS -->
  <section class="records s-dark section" data-surface="dark" aria-labelledby="rec-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="label"><span>06</span></p>
        <h2 id="rec-title" class="t-h1 rise" set:html={c.records.title} />
      </header>
      <ol class="records__desk" role="list">
        {c.records.items.map((r, i) => {
          const pin = recordPins[r.hash] ?? { layout: 'stamp' };
          return (
            <li
              class={`fiche fiche--${pin.layout}`}
              style={`--i:${i}`}
              data-dossier={recordGalleries[r.hash] ? JSON.stringify(recordGalleries[r.hash].map((p) => ({ src: p.src, w: p.w, h: p.h, cap: p.cap?.[lang], alt: p.alt[lang] }))) : undefined}
            >
              <a href={href('projects', lang, undefined, r.hash)}>
                <span class="fiche__pin">
                  {pin.layout === 'stamp' ? (
                    <span class="stamp mono" aria-hidden="true">{(r.stamp ?? [r.code]).map((line) => <span>{line}</span>)}</span>
                  ) : (
                    <>
                      {pin.prints!.map((p, k) => (
                        <span class={`print print--${k}`} style={`--ar:${(p.w / p.h).toFixed(3)}`}>
                          <img src={p.src} width={p.w} height={p.h} alt={r.alts?.[k] ?? ''} loading="lazy" decoding="async" />
                          {p.cap && <span class="print__cap mono" aria-hidden="true">{p.cap}</span>}
                        </span>
                      ))}
                      <Paperclip class="fiche__clip" />
                    </>
                  )}
                </span>
                <span class="fiche__kind label">{r.kind}</span>
                <h3 class="fiche__title serif">{r.title}</h3>
                <span class="fiche__text">{r.text}</span>
                <span class="fiche__foot"><span class="mono">{r.code}</span><Arrow /></span>
              </a>
            </li>
          );
        })}
      </ol>
      <a class="btn btn--ghost records__all" href={href('projects', lang)}>{c.records.all}<Arrow /></a>
      <!-- Dossier: a fiche with photos, pulled toward the viewer. The clipped prints become a one-photo viewer.
           Desktop: the paper sheet flies up from the card. Narrow screens: a dark full-screen gallery to swipe. -->
      <dialog class="dossier" data-dossier-dialog aria-labelledby="dossier-title">
        <div class="dossier__sheet" data-dossier-sheet>
          <button type="button" class="dossier__x" data-dossier-close aria-label={c.records.ui.close}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
          <div class="dossier__stage" role="group" aria-roledescription="carousel" aria-label={c.records.ui.gallery}>
            <div class="dossier__track" data-dossier-track></div>
            <button type="button" class="dossier__nav dossier__nav--prev" data-dossier-step="-1" aria-label={c.records.ui.prev}>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="dossier__nav dossier__nav--next" data-dossier-step="1" aria-label={c.records.ui.next}>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
          <p class="dossier__bar mono" aria-live="polite"><span data-dossier-cap></span><span class="dossier__count" data-dossier-count></span></p>
          <div class="dossier__body">
            <span class="dossier__kind label" data-dossier-kind></span>
            <h3 id="dossier-title" class="dossier__title serif" data-dossier-title></h3>
            <p class="dossier__text" data-dossier-text></p>
            <p class="dossier__foot"><span class="mono" data-dossier-code></span><a class="dossier__more" data-dossier-more href="#">{c.records.ui.more}<Arrow /></a></p>
          </div>
        </div>
        <template data-dossier-clip><Paperclip class="dossier__clip" /></template>
      </dialog>
    </div>
  </section>

  <!-- 08 · PROJECT & FUNDING -->
  <section class="funding s-light grain section" data-surface="light" aria-labelledby="fund-title">
    <div class="wrap funding__grid">
      <div class="funding__words">
        <p class="label"><span>07</span><span class="sep">·</span><span>{c.funding.label}</span></p>
        <h2 id="fund-title" class="t-h1 rise" set:html={c.funding.title} />
        <p class="t-lead rise">{c.funding.lead}</p>
        <ul class="funding__programs" role="list">
          {c.funding.programs.map((p) => <li class="mono">{p}</li>)}
        </ul>
        <ol class="funding__steps" role="list">
          {c.funding.steps.map((s, i) => <li><span class="num">{i + 1}</span>{s}</li>)}
        </ol>
        <a class="btn" href={href('funding', lang)}>{c.funding.link}<Arrow /></a>
      </div>
      <FileStack sheets={c.funding.sheets} />
    </div>
  </section>

  <!-- 09 · ALGOPHYCO -->
  <section class="algae s-dark section" data-surface="dark" aria-labelledby="algae-title">
    <Microscope />
    <div class="wrap algae__grid">
      <div class="algae__words">
        <p class="label">{c.algae.label}</p>
        <h2 id="algae-title" class="t-display rise" set:html={c.algae.title} />
        <p class="algae__text rise">{c.algae.text}</p>
        <p class="algae__fig"><span class="figure">{c.algae.fig}</span><span class="label">{c.algae.figCap}</span></p>
        <p class="label faint">{c.algae.local}</p>
        <a class="btn btn--light" href={href('algophyco', lang)}>{c.algae.link}<Arrow /></a>
      </div>
      <div class="algae__art">
        <Asset name="b-spirulina-powder" alt="" class="algae__powder" sizes="(max-width: 900px) 70vw, 34vw" />
        <Asset name="pk-algophyco-doypack" alt="ALGOPHYCO spirulina 250 g doypack" class="algae__pack algae__pack--1" sizes="(max-width: 900px) 40vw, 16vw" />
        <Asset name="pk-algophyco-jar" alt="ALGOPHYCO spirulina 900 g" class="algae__pack algae__pack--2" sizes="(max-width: 900px) 34vw, 13vw" />
      </div>
    </div>
  </section>

  <!-- 10 · NOTES -->
  <section class="notes s-light section" data-surface="light" aria-labelledby="notes-title">
    <div class="wrap">
      <header class="notes__head">
        <div>
          <p class="label">{c.notes.label}</p>
          <h2 id="notes-title" class="t-h1">{c.notes.title}</h2>
        </div>
        <a class="link" href={href('notes', lang)}>{c.notes.all}</a>
      </header>
      <div class="notes__grid">
        {notes.map((p) => <NoteCard post={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- 11 · BACK TO THE SURFACE -->
  <ClosingCta lang={lang} title={c.close.title} />
</Base>

<script>
  import { mountCaustics, mountPellets } from '../scripts/caustics';
  // Dossier. A fiche with photos opens instead of navigating (its link stays the no-JS fallback).
  // Desktop: the sheet flies up from the card (FLIP) and its head band becomes a one-photo viewer.
  // Narrow screens: the same dialog is styled as a dark full-screen gallery to swipe.
  const dlg = document.querySelector<HTMLDialogElement>('[data-dossier-dialog]');
  if (dlg) {
    type Print = { src: string; w: number; h: number; cap?: string; alt: string };
    const $ = <T extends Element = HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
    const sheet = $('[data-dossier-sheet]');
    const track = $('[data-dossier-track]');
    const prev = $<HTMLButtonElement>('[data-dossier-step="-1"]');
    const next = $<HTMLButtonElement>('[data-dossier-step="1"]');
    const clipTpl = $<HTMLTemplateElement>('[data-dossier-clip]');
    const narrow = matchMedia('(max-width: 760px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const tilt = [-1.2, 1, -0.6, 1.4];
    let prints: Print[] = [];
    let index = 0;
    let card: HTMLElement | null = null;
    let busy = false;

    const show = (i: number) => {
      index = i;
      $('[data-dossier-cap]').textContent = prints[i]?.cap ?? '';
      $('[data-dossier-count]').textContent = `${String(i + 1).padStart(2, '0')} / ${String(prints.length).padStart(2, '0')}`;
      prev.disabled = i === 0;
      // warm the photos either side so a step never lands on a blank print
      [i - 1, i + 1].forEach((k) => { const im = track.children[k]?.querySelector('img'); if (im) im.loading = 'eager'; });
      next.disabled = i === prints.length - 1;
    };
    let target = -1; // slide an arrow is travelling to; swipe positions are ignored until it arrives
    const go = (i: number) => {
      const to = Math.max(0, Math.min(prints.length - 1, i));
      if (to === index) return;
      target = to;
      show(to);
      (track.children[to] as HTMLElement).scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
    };
    // Which slide is in view after a swipe: the one whose centre is nearest the track's centre (RTL-safe).
    track.addEventListener('scroll', () => {
      const mid = track.getBoundingClientRect().left + track.clientWidth / 2;
      let best = 0, dist = Infinity;
      [...track.children].forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < dist) { dist = d; best = i; }
      });
      if (target >= 0) { if (best === target && dist < 2) target = -1; return; }
      if (best !== index) show(best);
    }, { passive: true });
    // A swipe or wheel cancels an arrow's travel lock, so the counter follows the hand again.
    ['pointerdown', 'wheel', 'scrollend'].forEach((ev) => track.addEventListener(ev, () => { target = -1; }, { passive: true }));
    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const rtl = document.documentElement.dir === 'rtl';
      go(index + ((e.key === 'ArrowRight') !== rtl ? 1 : -1));
    });

    // FLIP between the card and the sheet: translate + scale from one box to the other.
    const flip = (from: DOMRect, to: DOMRect, reverse: boolean) => {
      const t = `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`;
      const frames = [{ transform: t, opacity: 0.6 }, { transform: 'none', opacity: 1 }];
      const duration = reverse ? 420 : 560;
      return settle(sheet.animate(reverse ? frames.reverse() : frames, { duration, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }), duration);
    };
    // An animation's promise never settles while the tab is hidden; a timer guarantees we move on.
    const settle = async (an: Animation, ms: number) => {
      await Promise.race([an.finished.catch(() => {}), new Promise((r) => setTimeout(r, ms + 120))]);
      if (an.playState !== 'finished' && an.playState !== 'idle') an.finish();
    };
    const animate = () => !still.matches && !narrow.matches && !!card;

    const open = async (li: HTMLElement) => {
      if (busy || dlg.open) return;
      prints = JSON.parse(li.dataset.dossier!);
      card = li;
      const a = li.querySelector('a')!;
      const txt = (s: string) => li.querySelector(s)?.textContent ?? '';
      $('[data-dossier-kind]').textContent = txt('.fiche__kind');
      $('[data-dossier-title]').textContent = txt('.fiche__title');
      $('[data-dossier-text]').textContent = txt('.fiche__text');
      $('[data-dossier-code]').textContent = txt('.fiche__foot .mono');
      $<HTMLAnchorElement>('[data-dossier-more]').href = a.href;
      track.replaceChildren(...prints.map((p, i) => {
        const slide = document.createElement('figure');
        slide.className = 'dossier__slide';
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', 'slide');
        slide.setAttribute('aria-label', `${i + 1} / ${prints.length}`);
        const print = document.createElement('span');
        print.className = 'dossier__print';
        print.style.setProperty('--r', `${tilt[i % tilt.length]}deg`);
        const img = new Image(p.w, p.h);
        img.loading = i < 2 ? 'eager' : 'lazy'; // neighbours are promoted to eager in show()
        img.src = p.src; img.alt = p.alt; img.decoding = 'async';
        print.append(img, clipTpl.content.cloneNode(true));
        slide.append(print);
        return slide;
      }));
      dlg.classList.toggle('is-single', prints.length < 2);
      target = -1;
      show(0);
      busy = true;
      dlg.showModal();
      track.scrollLeft = 0;
      if (animate()) {
        const from = a.getBoundingClientRect();
        li.classList.add('is-lifted');
        await flip(from, sheet.getBoundingClientRect(), false);
        sheet.getAnimations().forEach((an) => an.cancel()); // the end state is the sheet's own; drop the fill
      }
      busy = false;
    };
    const close = async () => {
      if (busy || !dlg.open) return;
      busy = true;
      dlg.classList.add('is-closing');
      if (animate()) {
        const to = card!.querySelector('a')!.getBoundingClientRect();
        await flip(to, sheet.getBoundingClientRect(), true);
      } else if (!still.matches) {
        await settle(sheet.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 240, fill: 'both' }), 240);
      }
      dlg.classList.remove('is-closing');
      dlg.close();
      cleanup();
      busy = false;
    };
    const cleanup = () => {
      if (!card) return;
      sheet.getAnimations().forEach((an) => an.cancel());
      card.classList.remove('is-lifted');
      card.querySelector('a')?.focus({ preventScroll: true });
      card = null;
    };
    dlg.addEventListener('close', cleanup);
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    $('[data-dossier-close]').addEventListener('click', close);
    // Click on the veil (the dialog itself) or the empty space around a photo closes.
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.classList.contains('dossier__slide')) close();
    });

    document.querySelectorAll<HTMLElement>('.fiche[data-dossier]').forEach((li) => {
      const a = li.querySelector('a')!;
      a.setAttribute('aria-haspopup', 'dialog');
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(li);
      });
    });
  }

  const water = document.querySelector<HTMLCanvasElement>('[data-caustics]');
  const pellets = document.querySelector<HTMLCanvasElement>('[data-pellets]');
  if (water) mountCaustics(water);
  if (pellets) mountPellets(pellets, matchMedia('(max-width: 760px)').matches ? 10 : 18);

  // Worlds.
  // Desktop: the panel under the pointer (or in focus) widens.
  // Narrow screens (≤900px): three fixed, always-open cards in the page flow — pure CSS, nothing to drive
  // here; the cards are plain links and the page scrolls natively.
  const row = document.querySelector<HTMLElement>('[data-worlds]');
  const stage = row?.querySelector<HTMLElement>('[data-stage]');
  if (row && stage) {
    const panels = [...row.querySelectorAll<HTMLElement>('[data-world]')];
    const narrow = matchMedia('(max-width: 900px)');
    let active = -1;
    const set = (idx: number) => {
      if (idx === active) return;
      active = idx;
      panels.forEach((p, i) => p.classList.toggle('is-open', i === idx));
      stage.dataset.active = String(idx);
    };
    panels.forEach((p, i) => {
      p.addEventListener('pointerenter', (e) => { if (!narrow.matches && e.pointerType === 'mouse') set(i); });
      p.addEventListener('focus', () => { if (!narrow.matches) set(i); });
    });
    row.addEventListener('pointerleave', (e) => { if (!narrow.matches && e.pointerType === 'mouse') set(-1); });
    const mode = () => { active = Number.NaN; set(-1); };
    narrow.addEventListener('change', mode);
    mode();
  }
</script>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative; min-height: max(100svh, 680px);
    display: grid; grid-template-rows: 1fr auto auto;
    overflow: hidden; isolation: isolate;
    background:
      radial-gradient(120% 70% at 60% -10%, rgba(130, 204, 240, 0.28), transparent 60%),
      repeating-radial-gradient(ellipse at 30% -40%, transparent 0 22px, rgba(130, 204, 240, 0.05) 23px 25px),
      linear-gradient(180deg, #0c3a67 0%, var(--abyss-2) 45%, var(--abyss) 100%);
  }
  .hero__water, .hero__pellets { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .hero__water { opacity: 0; transition: opacity 1600ms var(--ease-water); }
  .hero__water:global(.is-live) { opacity: 1; }
  .hero__pellets { z-index: -1; }
  .hero__veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(6, 26, 51, 0) 40%, rgba(6, 26, 51, 0.82) 100%), linear-gradient(90deg, rgba(6, 26, 51, 0.55), transparent 65%); }
  :global(html[dir='rtl']) .hero__veil { background: linear-gradient(180deg, rgba(6, 26, 51, 0) 40%, rgba(6, 26, 51, 0.82) 100%), linear-gradient(-90deg, rgba(6, 26, 51, 0.55), transparent 65%); }
  .hero__inner { align-self: center; padding-top: calc(var(--header-h) + 6vh); display: grid; gap: clamp(1.25rem, 2.4vw, 2.2rem); }
  .hero__kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.95rem; color: var(--aegean); animation: hero-surface 1400ms 80ms var(--ease-water) both; }
  .hero__place { font-family: var(--f-mono); font-weight: 500; text-transform: uppercase; font-size: clamp(1.15rem, 1.5vw, 1.45rem); line-height: 1; letter-spacing: 0.06em; color: var(--aegean-pale); }
  /* a short length of sounding line: hairline, tick marks, brass lead at the end */
  .hero__sounding { position: relative; flex: none; width: clamp(44px, 5.5vw, 84px); height: 7px; }
  .hero__sounding::before {
    content: ''; position: absolute; inset: 0; opacity: 0.7;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 10px) center / 100% 7px no-repeat;
    -webkit-mask: linear-gradient(90deg, transparent, #000 45%);
    mask: linear-gradient(90deg, transparent, #000 45%);
  }
  .hero__sounding::after { content: ''; position: absolute; inset-inline-end: -2px; top: 50%; width: 5px; height: 5px; margin-top: -2.5px; border-radius: 50%; background: var(--brass-2); box-shadow: 0 0 0 3px rgba(210, 145, 76, 0.2); }
  :global(html[dir='rtl']) .hero__sounding::before { -webkit-mask: linear-gradient(-90deg, transparent, #000 45%); mask: linear-gradient(-90deg, transparent, #000 45%); }
  .hero__claim { display: inline-block; color: inherit; opacity: 0.88; }
  .hero__yr { font-weight: 500; color: var(--brass-2); }
  /* Büyük harf Türkçe aksanları (Ü, İ, Ö, Ğ) taban çizgisinin ~0.92em üstüne çıkar; .t-mega'nın 0.86
     satır aralığında üst satıra değiyordu. em cinsinden: her ölçekte ~0.08em boşluk kalır. */
  .hero__title { color: #eaf6fd; text-transform: uppercase; line-height: 1; }
  .hero__w:first-child { display: block; }
  .hero__w { display: inline-block; margin-inline-end: 0.22em; animation: hero-surface 1600ms var(--ease-water) both; animation-delay: calc(240ms + var(--i) * 140ms); }
  .hero__title em { color: var(--aegean); }
  @keyframes hero-surface { from { opacity: 0; transform: translateY(0.35em); filter: blur(10px); } 60% { filter: blur(1px); } to { opacity: 1; transform: none; filter: blur(0); } }
  .hero__lead { color: rgba(207, 234, 248, 0.82); animation: hero-surface 1400ms 820ms var(--ease-water) both; max-width: 44ch; }

  .hero__intents { padding-bottom: clamp(2rem, 5vh, 3.5rem); display: grid; gap: 0.9rem; animation: hero-surface 1400ms 1000ms var(--ease-water) both; }
  .hero__intents ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule-light-strong); }
  .hero__intents li + li { border-inline-start: 1px solid var(--rule-light); }
  .hero__intents a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.9rem; padding: 1.15rem 1.1rem 1.15rem 0; min-height: 72px; transition: background 500ms var(--ease-water), padding 500ms var(--ease-water); }
  .hero__intents li + li a { padding-inline-start: 1.1rem; }
  .hero__intents a:hover, .hero__intents a:focus-visible { background: linear-gradient(180deg, rgba(130, 204, 240, 0.1), transparent); }
  .hero__intents .arr { opacity: 0.5; transition: transform 500ms var(--ease-water), opacity 300ms; }
  .hero__intents a:hover .arr { opacity: 1; transform: translateX(4px); }
  .hero__intent { font-size: 1.02rem; font-weight: 500; color: #eaf6fd; }
  .hero__seam { position: absolute; inset-inline: 0; bottom: -1px; width: 100%; height: clamp(40px, 8vw, 120px); fill: var(--foam); transform-origin: bottom; z-index: 1; pointer-events: none; }
  @supports (animation-timeline: view()) {
    .hero__seam { animation: hero-seam linear both; animation-timeline: view(); animation-range: exit 0% exit 70%; }
    .hero__inner, .hero__intents { animation: hero-out linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
    .hero__water { animation: water-out linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
  }
  @keyframes hero-seam { from { transform: scaleY(0.25); } to { transform: scaleY(2.4); } }
  @keyframes hero-out { to { transform: translateY(-12vh); opacity: 0; } }
  @keyframes water-out { to { filter: brightness(0.45); transform: scale(1.06); } }
  @media (max-width: 960px) {
    .hero__intents ul { grid-template-columns: 1fr 1fr; }
    .hero__intents li:nth-child(3) { border-inline-start: 0; }
